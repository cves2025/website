// TEMPORARY - permissive rules for development. Restore proper role-based rules before production.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // TODO: re-enable proper role-based rules (admins only for school data)
    // before going to production - see the previous version of this file.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}