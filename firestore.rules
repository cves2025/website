rules_version = '2';

// ===========================================================================
// Cloud Firestore security rules for CVES (website + mobile app)
// ---------------------------------------------------------------------------
// The same file is deployed to dev (schoolproject-284dc) and prod
// (childrensvalley). Map of who may do what: docs/features/security-rules.md
//
// Who is who (same as MyContextProvider.buildUser):
//   - staff   = signed in, users/{uid} exists, role "admin" or "teacher",
//               not deleted, status "Active" or empty
//   - admin   = staff with role "admin"
//   - can(p)  = admin, or a teacher who has permission p
//               (mirror of resolvePermissions: school defaults from
//               panelSettings/rolePermissions + the teacher's own
//               permissionOverrides; admin-only permissions never)
//   - public  = anyone, also not signed in (the school website pages)
//
// Anything not listed below is denied.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is signed in ----------

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function profile() {
      return get(userPath()).data;
    }

    // Not deleted, status "Active" or empty (an old profile has no status).
    function isActive(data) {
      return data.get('isDeleted', false) != true
        && data.get('status', 'Active') in ['Active', ''];
    }

    function hasRole(roles) {
      return signedIn()
        && exists(userPath())
        && isActive(profile())
        && profile().get('role', '') in roles;
    }

    function isStaff() {
      return hasRole(['admin', 'teacher']);
    }

    function isAdmin() {
      return hasRole(['admin']);
    }

    function isTeacher() {
      return hasRole(['teacher']);
    }

    // ---------- teacher permissions ----------
    // MIRROR of src/permissions (rolePermissions.ts, resolvePermissions.ts,
    // permissionCatalog.ts, utils/permissionSettingsService.ts). When a
    // permission list changes there, change it here too.

    // ROLE_PERMISSIONS.teacher
    function builtInTeacher() {
      return ['student.read', 'student.formView', 'marks.enter', 'marks.view',
              'result.view', 'profile.view', 'attendance.mark'];
    }

    // CLASS_TEACHER_BONUS
    function builtInClassTeacher() {
      return ['admitcard.view', 'crosslist.view', 'attendance.view', 'student.photo'];
    }

    // TEACHER_BLOCKED_PERMISSIONS: a teacher never gets these.
    function teacherBlocked() {
      return ['student.create', 'student.promote', 'teacher.create', 'exam.manage',
              'examSettings.access', 'settings.access', 'permissions.manage', 'fee.manage',
              'tc.settings'];
    }

    // LEGACY_CATALOG_PERMISSIONS: what the Permissions page offered before it
    // saved `known` (the whole catalog without profile.view, student.formView).
    function legacyCatalog() {
      return ['banner.manage', 'news.manage', 'gallery.manage', 'downloads.manage',
              'student.read', 'subject.manage',
              'attendance.mark', 'attendance.view', 'holiday.manage',
              'idcard.student', 'idcard.teacher', 'idcard.staff', 'idcard.admin',
              'admitcard.view', 'admitcard.generate', 'deskslip.access',
              'marks.enter', 'marks.view', 'crosslist.view', 'result.view'];
    }

    function asList(value) {
      return value is list ? value : [];
    }

    // parseTeacherRoleDefaults: the saved list, plus a built-in default that
    // the page did not know about when the document was saved.
    function savedOn(saved, builtIn, known, p) {
      return p in asList(saved) || (p in builtIn && !(p in known));
    }

    function defaultsDocOn(d, p, classTeacher) {
      let known = d.get('known', null) is list ? d.known : legacyCatalog();
      return savedOn(d.get('teacher', []), builtInTeacher(), known, p)
        || (classTeacher && savedOn(d.get('classTeacher', []), builtInClassTeacher(), known, p));
    }

    // isClassTeacherProfile. Rules cannot look inside the sectionAssignments
    // list, so this reads the isClassTeacher flag that Add Teacher keeps in
    // step with it.
    function isClassTeacher() {
      return profile().get('isClassTeacher', false) == true;
    }

    function teacherDefaultOn(p) {
      let path = /databases/$(database)/documents/panelSettings/rolePermissions;
      return exists(path)
        ? defaultsDocOn(get(path).data, p, isClassTeacher())
        : (p in builtInTeacher() || (isClassTeacher() && p in builtInClassTeacher()));
    }

    function teacherCan(p) {
      let overrides = profile().get('permissionOverrides', {});
      return isTeacher()
        && !(p in teacherBlocked())
        && !(p in asList(overrides.get('revoke', [])))
        && (p in asList(overrides.get('grant', [])) || teacherDefaultOn(p));
    }

    function can(p) {
      return isAdmin() || teacherCan(p);
    }

    // A Transfer Certificate as it will be after this write (tcVerify rules).
    function tcAfter(tcId) {
      return getAfter(/databases/$(database)/documents/transferCertificates/$(tcId)).data;
    }

    // Ids of the tcNumbers locks of a TC: its Book No. + Sr. No. and its TC No.
    // ("/" -> "_"; a TC No. has no "_" of its own).
    function tcSerialLockId(d) {
      return 'sr_' + d.bookNo + '_' + string(d.srNo);
    }
    function tcNoLockId(d) {
      return 'tc_' + d.tcNo.replace('/', '_');
    }

    // An issued TC must have a whole Sr. No. above 0, a valid Book No. and
    // TC No., and both of its locks (tcNumbers) written for it in the same
    // transaction, so neither number is ever on two TCs.
    function tcNumberLocked(tcId) {
      let d = request.resource.data;
      return d.status != 'issued'
        || (d.srNo is int && d.srNo > 0
          && d.bookNo is string && d.bookNo.matches('^[A-Za-z0-9-]{1,10}$')
          && d.tcNo is string && d.tcNo.matches('^[A-Za-z0-9/-]{1,30}$')
          && getAfter(/databases/$(database)/documents/tcNumbers/$(tcSerialLockId(d))).data.tcId == tcId
          && getAfter(/databases/$(database)/documents/tcNumbers/$(tcNoLockId(d))).data.tcId == tcId);
    }

    // ---------- users (teachers, staff, admins) ----------

    match /users/{userId} {
      // Own profile always (the app shows "inactive" / "no access" from it);
      // the staff list for staff (ID cards, class teacher names...).
      allow read: if (signedIn() && request.auth.uid == userId) || isStaff();
      // Add / edit / delete (isDeleted) teacher and staff, permission
      // overrides. Teachers with a login are created by the server.
      allow create, update, delete: if isAdmin();
      // "What's new" dialog: a user may only mark the release as seen.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastSeenReleaseId', 'updatedAt']);
    }

    // ---------- students and classes ----------

    match /students/{studentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
      // Students page of the mobile app: only the three photos.
      allow update: if can('student.photo')
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['studentPhoto', 'fatherPhoto', 'motherPhoto', 'updatedAt']);
    }

    match /enrollments/{enrollmentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
      // Issuing a TC marks the student Left.
      allow update: if can('tc.issue')
        && request.resource.data.isDeleted == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isDeleted', 'leftReason', 'tcNo', 'leftAt', 'updatedAt']);
    }

    match /rollNumber/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isStaff();
      allow write: if can('subject.manage');
    }

    // ---------- exams, marks, results ----------

    match /exams/{examId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /examSchedules/{docId} {
      allow read: if isStaff();
      allow write: if can('admitcard.generate');
    }

    // Marks entry writes marks + marksProgress (+ examSheets the first time)
    // together; Student Promote (admin) moves marks / attendance.
    match /marks/{docId} {
      allow read: if isStaff();
      allow write: if can('marks.enter');
    }

    match /marksProgress/{docId} {
      allow read: if isStaff();
      allow write: if can('marks.enter');
    }

    match /examSheets/{docId} {
      allow read: if isStaff();
      allow write: if can('marks.enter');
    }

    // Present / total days of an exam term (result card), saved on Marks.
    match /attendance/{docId} {
      allow read: if isStaff();
      allow write: if can('marks.enter');
    }

    // Principal's signature and school stamp (result card, ID cards).
    match /stampSign/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------- daily attendance ----------

    match /dailyAttendance/{docId} {
      allow read: if isStaff();
      allow write: if can('attendance.mark');
    }

    match /holidayCalendar/{session} {
      allow read: if isStaff();
      allow write: if can('holiday.manage');
    }

    // ---------- website content (public pages) ----------
    // The public pages only ask for published items (where isPublished ==
    // true); the manage pages read everything.

    match /news/{newsId} {
      allow read: if resource.data.isPublished == true || isStaff();
      allow write: if can('news.manage');
    }

    match /gallery/{photoId} {
      allow read: if resource.data.isPublished == true || isStaff();
      allow write: if can('gallery.manage');
    }

    match /downloads/{fileId} {
      allow read: if resource.data.isPublished == true || isStaff();
      allow write: if can('downloads.manage');
    }

    // ---------- settings ----------

    // homeBanner: Home page slides (public). admitCard, idCard: templates.
    match /settings/{docId} {
      allow read: if docId == 'homeBanner' || isStaff();
      allow write: if (docId == 'homeBanner' && can('banner.manage'))
        || (docId != 'homeBanner' && isAdmin());
    }

    // ---------- transfer certificates ----------

    // Draft -> issued (Book No. + Sr. No. typed by the admin, locked in
    // tcNumbers) -> cancelled (admin). An issued TC is never deleted and keeps
    // its number.
    match /transferCertificates/{tcId} {
      allow read: if can('tc.view') || can('tc.issue');
      allow create: if can('tc.issue')
        && request.resource.data.status in ['draft', 'issued']
        && tcNumberLocked(tcId);
      // Draft saved again or issued; an issued TC revised (number kept).
      allow update: if can('tc.issue')
        && ((resource.data.status == 'draft'
              && request.resource.data.status in ['draft', 'issued']
              && tcNumberLocked(tcId))
          || (resource.data.status == 'issued'
              && request.resource.data.status == 'issued'
              && request.resource.data.srNo == resource.data.srNo
              && request.resource.data.bookNo == resource.data.bookNo
              && request.resource.data.tcNo == resource.data.tcNo));
      // Printing an issued TC counts the copies (later ones say DUPLICATE).
      allow update: if (can('tc.view') || can('tc.issue'))
        && resource.data.status == 'issued'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['printCount', 'lastPrintedAt']);
      allow update: if isAdmin()
        && resource.data.status == 'issued'
        && request.resource.data.status == 'cancelled';
      allow delete: if can('tc.issue') && resource.data.status == 'draft';
    }

    // Two per issued TC: "sr_<book>_<sr>" and "tc_<TC No. with / as _>". Created
    // with the TC they belong to and never changed or deleted, so no two TCs
    // share a number (a cancelled TC keeps its numbers too).
    match /tcNumbers/{numberId} {
      allow get: if can('tc.issue');
      allow list: if false;
      allow create: if can('tc.issue')
        && request.resource.data.keys().hasOnly(['tcId', 'tcNo', 'createdAt'])
        && tcAfter(request.resource.data.tcId).status == 'issued'
        && numberId in [tcSerialLockId(tcAfter(request.resource.data.tcId)),
          tcNoLockId(tcAfter(request.resource.data.tcId))]
        && request.resource.data.tcNo == tcAfter(request.resource.data.tcId).tcNo;
      allow update, delete: if false;
    }

    // Public copy of an issued TC for the QR verify page (/verify-tc/<tcId>).
    // Anyone may read ONE by its id (the random TC id), nobody may list them.
    // Written together with the TC (issue / revise / cancel) and must match it:
    // same status, TC No. and student name as the TC after the write.
    match /tcVerify/{tcId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if can('tc.issue')
        && request.resource.data.keys().hasOnly(['status', 'tcNo', 'studentName',
          'fatherName', 'lastClass', 'session', 'struckOffDate', 'issueDate',
          'cancelledAt', 'schoolName', 'updatedAt'])
        && request.resource.data.status in ['issued', 'cancelled']
        && request.resource.data.status == tcAfter(tcId).status
        && request.resource.data.tcNo == tcAfter(tcId).tcNo
        && request.resource.data.studentName == tcAfter(tcId).fields.studentName;
      allow delete: if false;
    }

    // siteImages (school photo) + galleryImport: public pages, Settings > Gallery.
    // rolePermissions: read by every signed-in app when it starts.
    // exam (exam rules), suggestedRemarks, enrollmentCounter...: admin pages.
    // Unlock PIN hashes: only the server (Admin SDK) reads / writes them.
    match /pinSecrets/{uid} {
      allow read, write: if false;
    }

    // lockSettings (unlock with password / PIN): staff read, admin write.
    match /panelSettings/{docId} {
      allow read: if docId in ['siteImages', 'galleryImport']
        || (docId == 'rolePermissions' && signedIn())
        || isStaff();
      allow write: if (docId in ['siteImages', 'galleryImport'] && can('gallery.manage'))
        || isAdmin();
    }

    // ---------- fee module (admin only) ----------

    // Read by the public Pay Fee page; changed on Fees > Fee Structure.
    match /feeStructures/{session} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /feeSettings/{docId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // A student's fee lines of a session. Never deleted.
    match /feeAccounts/{accountId} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    // Receipts: never deleted, and once saved the only change allowed is
    // cancelling an active receipt (status + who / why / when).
    match /feePayments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'active';
      allow update: if isAdmin()
        && resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'cancelReason', 'cancelledByName', 'cancelledBy', 'cancelledAt']);
      allow delete: if false;
    }

    // Last receipt serial of a session: starts at 1 and only ever goes up by
    // one, so a receipt number can never be repeated.
    match /feeCounters/{session} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.lastSerial == 1;
      allow update: if isAdmin()
        && request.resource.data.lastSerial == resource.data.lastSerial + 1;
      allow delete: if false;
    }
  }
}
