# Deployed development build (npm run deploy:dev).
# Same as .env.development — (default) Firestore DB + dev storage bucket —
# but uses the hosted backend, which picks the DB from the X-App-Env header.
VITE_APP_ENV=dev
VITE_FIRESTORE_DB_ID=(default)
VITE_FIREBASE_STORAGE_BUCKET=schoolproject-284dc.appspot.com
VITE_API_BASE_URL=https://school-backend-api-913523658602.asia-south1.run.app
